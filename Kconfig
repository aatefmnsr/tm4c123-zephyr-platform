mainmenu "TM4C123 Zephyr Application"

# Source Zephyr's root Kconfig tree
source "Kconfig.zephyr"

menu "TM4C123 Application Configuration"

config APP_WELCOME_BANNER
	bool "Display custom welcome banner on boot"
	default y
	help
	  When enabled, the application prints a formatted system banner
	  detailing hardware platform, RTOS version, and CLI commands.

config APP_ENABLE_DTS_INSPECTION_CMD
	bool "Enable runtime Devicetree introspection shell command"
	default y
	help
	  Exposes the 'tm4c dts' shell command to introspect hardware configuration
	  and compile-time Devicetree properties from the interactive CLI.

config APP_ENABLE_GPIO_DEMO
	bool "Enable GPIO LED and Button control subsystem"
	default y
	help
	  Initializes on-board RGB LEDs (PF1, PF2, PF3) and pushbuttons
	  SW1 (PF4) and SW2 (PF0) with interrupt handlers and shell commands.

endmenu
